---
import { useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import paoloImg from '../../assets/images/paolo.webp';
import Layout from '../../layouts/Layout.astro';

interface Props {
  lang: 'es' | 'en' | 'ca';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const orcidUrl = 'https://orcid.org/0000-0003-3130-8537';
const instagramUrl = 'https://www.instagram.com/pedra_tallada/';
const profileLinks = [
    { label: 'ORCID', href: orcidUrl },
    { label: 'ResearchGate', href: 'https://www.researchgate.net/profile/Juan-Pablo-Donadei' },
    { label: 'Academia.edu', href: 'https://eraseunavezerase.academia.edu/JuanPabloDonadei' },
    { label: 'Instagram', href: instagramUrl },
    { label: 'Facebook', href: 'https://www.facebook.com/profile.php?id=100093317785372&locale=es_ES' },
];
const inlineLinkClass = 'font-bold text-clay-dark underline underline-offset-2 hover:text-stone-900';
---

<Layout
	title={`${t('about.title')} | Pedra Tallada`}
	description={t('about.intro')}
>
	<section class="max-w-4xl mx-auto py-12 md:py-20 px-4">
		<h1 class="text-4xl md:text-5xl font-serif text-stone-900 mb-8">{t('about.title')}</h1>
		<div class="prose prose-stone prose-lg">
			<p>{t('about.intro')}</p>
			<p>{t('about.mission')}</p>
		</div>

		<!-- Director Section -->
		<div class="mt-16 bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
			<div class="md:flex">
				<div class="md:w-1/3 object-cover">
					<Image 
						src={paoloImg} 
						alt="Dr. Juan Pablo Donadei Corada" 
						class="w-full h-full object-cover min-h-[300px]"
                        width={600}
                        height={800}
						format="webp"
						loading="lazy"
					/>
				</div>
				<div class="md:w-2/3 p-8 md:p-10 flex flex-col justify-center">
					<h2 class="text-3xl font-serif font-bold text-stone-900 mb-2">
                        {lang === 'es' ? 'Dirección' : lang === 'en' ? 'Director' : 'Direcció'}
                    </h2>
					<h3 class="text-xl font-bold text-clay-dark mb-4">
                        Dr. Juan Pablo Donadei Corada - nº colegiado 3866
                    </h3>
					<div class="prose prose-stone prose-md text-stone-600 space-y-4">
						<p>
                            {lang === 'ca'
                                ? <Fragment>Doctor en Arqueologia amb més de 15 anys d'experiència en <a href={orcidUrl} target="_blank" rel="noopener noreferrer" class={inlineLinkClass}>investigació</a>, excavació i gestió del patrimoni cultural. Especialista en Prehistòria, anàlisi del territori i estudi dels recursos naturals, combina el rigor científic amb la pràctica professional en arqueologia preventiva i d'urgència.</Fragment>
                                : lang === 'en'
                                ? <Fragment>PhD in Archaeology with over 15 years of experience in <a href={orcidUrl} target="_blank" rel="noopener noreferrer" class={inlineLinkClass}>research</a>, excavation, and cultural heritage management. Specialist in Prehistory, territorial analysis, and natural resources study, he combines scientific rigor with professional practice in preventive and emergency archaeology.</Fragment>
                                : <Fragment>Doctor en Arqueología con más de 15 años de experiencia en <a href={orcidUrl} target="_blank" rel="noopener noreferrer" class={inlineLinkClass}>investigación</a>, excavación y gestión del patrimonio cultural. Especialista en Prehistoria, análisis del territorio y estudio de los recursos naturales, combina el rigor científico con la práctica profesional en arqueología preventiva y de urgencia.</Fragment>}
                        </p>
						<p>
                            {lang === 'ca'
                                ? 'Ha participat en projectes internacionals d\'investigació i en intervencions vinculades a obra civil i infraestructures, garantint una gestió tècnica solvent i ajustada a la normativa vigent.'
                                : lang === 'en'
                                ? 'He has participated in international research projects and interventions linked to civil works and infrastructure, ensuring sound technical management in accordance with current regulations.'
                                : 'Ha participado en proyectos internacionales de investigación y en intervenciones vinculadas a obra civil e infraestructuras, garantizando una gestión técnica solvente y ajustada a la normativa vigente.'}
                        </p>
						<p>
                            {lang === 'ca'
                                ? <Fragment>Director de Pedra Tallada, impulsa a més <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class={inlineLinkClass}>iniciatives d'arqueologia experimental i divulgació científica</a> que integren patrimoni, paisatge i sostenibilitat ambiental.</Fragment>
                                : lang === 'en'
                                ? <Fragment>Director of Pedra Tallada, he also promotes <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class={inlineLinkClass}>initiatives in experimental archaeology and scientific outreach</a> that integrate heritage, landscape, and environmental sustainability.</Fragment>
                                : <Fragment>Director de Pedra Tallada, impulsa además <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class={inlineLinkClass}>iniciativas de arqueología experimental y divulgación científica</a> que integran patrimonio, paisaje y sostenibilidad ambiental.</Fragment>}
                        </p>
					</div>
					<ul class="mt-6 flex flex-wrap gap-2">
						{profileLinks.map((link) => (
							<li>
								<a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-block px-4 py-1.5 rounded-full border border-stone-200 bg-stone-50 text-sm font-semibold text-stone-700 hover:bg-clay-dark hover:text-white hover:border-clay-dark transition-colors">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>
</Layout>
